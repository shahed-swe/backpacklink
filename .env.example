# Copy this file to ".env" and fill in your real values.
# ".env" is gitignored and must NEVER be committed or shared.

ESIMCARD_BASE_URL=https://portal.esimcard.com/api/developer/reseller
# Your esimcard reseller Bearer token (format: "1107468|xxxxxxxx...").
# Rotate this token in the esimcard portal before going to production.
ESIMCARD_TOKEN=PUT_YOUR_TOKEN_HERE

# Backend
NODE_ENV=development
API_PORT=4000
CORS_ORIGINS=*

# Pricing / markup engine
# Retail price = wholesale * (1 + MARKUP_PERCENT/100), with an optional minimum profit floor.
MARKUP_PERCENT=50
MARKUP_MIN_PROFIT=0
DISPLAY_CURRENCY=USD
