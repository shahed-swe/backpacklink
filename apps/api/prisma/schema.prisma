// BackpackLink data model — our own database (customers, eSIM mapping, orders).
// Dev uses SQLite (zero-setup). For production switch provider to "postgresql".

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  phone        String?
  name         String?
  passwordHash String
  role         String   @default("customer") // customer | admin
  country      String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  esims         Esim[]
  orders        Order[]
  supportThread SupportThread?
  tips          Tip[]
}

// The critical customer <-> eSIM mapping. esimcard has no idea which customer
// owns which eSIM — this table is the link, populated at fulfillment time.
model Esim {
  id                   String   @id @default(cuid())
  userId               String
  user                 User     @relation(fields: [userId], references: [id])
  providerEsimId       String // esimcard sim uuid
  iccid                String
  status               String   @default("Pending")
  lastBundle           String?
  // install payload captured from esimcard /my-esims
  qrCodeText           String?
  smdpAddress          String?
  matchingId           String?
  universalLinkIos     String?
  universalLinkAndroid String?
  pukCode              String?
  apn                  String?
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  orders Order[]

  @@index([userId])
  @@index([iccid])
}

model Order {
  id                String   @id @default(cuid())
  userId            String
  user              User     @relation(fields: [userId], references: [id])
  esimId            String?
  esim              Esim?    @relation(fields: [esimId], references: [id])
  providerPackageId String
  packageName       String
  packageType       String // DATA-ONLY | DATA-VOICE-SMS
  retailPrice       Float
  wholesalePrice    Float
  currency          String   @default("USD")
  // pending -> paid -> fulfilling -> completed | failed | refunded
  status            String   @default("pending")
  isTopup           Boolean  @default(false)
  topupIccid        String?
  paymentProvider   String? // stripe
  paymentRef        String? // stripe payment intent / session id
  providerOrderRef  String? // esimcard order/sim ref
  failureReason     String?

  // --- Discounts & attribution (growth features) ---
  couponId       String?
  coupon         Coupon?     @relation(fields: [couponId], references: [id])
  couponCode     String? // snapshot of the code entered
  discountAmount Float       @default(0) // amount taken off retail
  influencerId   String?
  influencer     Influencer? @relation(fields: [influencerId], references: [id])
  source         String? // utm_source or referrer host or "direct"
  medium         String? // utm_medium
  campaign       String? // utm_campaign
  referrer       String? // document.referrer host

  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@index([userId])
  @@index([status])
  @@index([couponId])
  @@index([influencerId])
  @@index([source])
}

// Key-value app settings (markup overrides, low-balance threshold, etc.)
model Setting {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt
}

// Processed Stripe webhook event ids — for idempotency (ignore replays).
model WebhookEvent {
  id        String   @id // stripe event id (evt_...)
  type      String
  createdAt DateTime @default(now())
}

// --- Support chat (one thread per customer, real-time via socket.io) ---
model SupportThread {
  id            String   @id @default(cuid())
  userId        String   @unique
  user          User     @relation(fields: [userId], references: [id])
  status        String   @default("open") // open | closed
  unreadByAdmin Int      @default(0)
  unreadByUser  Int      @default(0)
  lastMessageAt DateTime @default(now())
  createdAt     DateTime @default(now())

  messages SupportMessage[]

  @@index([lastMessageAt])
}

model SupportMessage {
  id         String        @id @default(cuid())
  threadId   String
  thread     SupportThread @relation(fields: [threadId], references: [id])
  senderId   String
  senderRole String // customer | admin
  body       String
  createdAt  DateTime      @default(now())

  @@index([threadId])
}

// --- Community tips feed ("worked great in <country>") ---
model Tip {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  country   String
  body      String
  photoUrl  String?
  status    String   @default("approved") // approved | hidden
  likes     Int      @default(0)
  createdAt DateTime @default(now())

  @@index([status])
  @@index([country])
}

// --- Growth: campaign bar + banners (fully admin-managed, event-driven) ---
model Promotion {
  id         String    @id @default(cuid())
  kind       String // "bar" | "banner"
  title      String
  subtitle   String?
  imageUrl   String?
  bgColor    String? // optional hex override e.g. "#0bb7a8"
  textColor  String? // optional hex override
  ctaLabel   String?
  ctaUrl     String?
  couponCode String? // optional: this promo advertises a coupon
  placement  String    @default("both") // "web" | "mobile" | "both"
  priority   Int       @default(0) // higher shows first
  active     Boolean   @default(true)
  startsAt   DateTime? // null = no start bound
  endsAt     DateTime? // null = no end bound
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  @@index([active])
}

// --- Growth: influencers / affiliates ---
model Influencer {
  id              String   @id @default(cuid())
  name            String
  handle          String? // @handle
  platform        String? // instagram | youtube | tiktok | ...
  email           String?
  refCode         String   @unique // used in ?ref=CODE links and (optionally) as a coupon code
  commissionType  String? // "percent" | "fixed" | null
  commissionValue Float? // e.g. 10 => 10% or $10 per sale
  active          Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  coupons Coupon[]
  orders  Order[]

  @@index([refCode])
}

// --- Growth: coupon / discount codes ---
model Coupon {
  id             String    @id @default(cuid())
  code           String    @unique // matched case-insensitively in app logic
  description    String?
  discountType   String // "percent" | "fixed"
  discountValue  Float // 15 => 15% or $15
  minSubtotal    Float? // minimum order retail to apply
  maxRedemptions Int? // null = unlimited
  perUserLimit   Int?      @default(1)
  redemptions    Int       @default(0) // completed uses
  active         Boolean   @default(true)
  startsAt       DateTime?
  endsAt         DateTime?
  influencerId   String?
  influencer     Influencer? @relation(fields: [influencerId], references: [id])
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  orders Order[]

  @@index([active])
}
