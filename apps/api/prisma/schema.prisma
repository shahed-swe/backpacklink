// BackpackLink data model — our own database (customers, eSIM mapping, orders).
// Dev uses SQLite (zero-setup). For production switch provider to "postgresql".

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id           String    @id @default(cuid())
  email        String    @unique
  phone        String?
  name         String?
  passwordHash String
  role         String    @default("customer") // customer | admin
  country      String?
  // Set when the customer deletes their account. Orders/eSIMs must be retained
  // as financial records, so we scrub the identity they point at instead of
  // deleting the row. A deleted user can never authenticate again.
  deletedAt    DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  esims         Esim[]
  orders        Order[]
  supportThread SupportThread?
  tips          Tip[]
  affiliate     Influencer?

  tipReports     TipReport[]
  blocksMade     UserBlock[] @relation("BlocksMade")
  blocksReceived UserBlock[] @relation("BlocksReceived")
}

// The critical customer <-> eSIM mapping. esimcard has no idea which customer
// owns which eSIM — this table is the link, populated at fulfillment time.
model Esim {
  id                   String   @id @default(cuid())
  userId               String
  user                 User     @relation(fields: [userId], references: [id])
  providerEsimId       String // esimcard sim uuid
  iccid                String
  status               String   @default("Pending")
  lastBundle           String?
  // install payload captured from esimcard /my-esims
  qrCodeText           String?
  smdpAddress          String?
  matchingId           String?
  universalLinkIos     String?
  universalLinkAndroid String?
  pukCode              String?
  apn                  String?
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  orders Order[]

  @@index([userId])
  @@index([iccid])
}

model Order {
  id                String   @id @default(cuid())
  userId            String
  user              User     @relation(fields: [userId], references: [id])
  esimId            String?
  esim              Esim?    @relation(fields: [esimId], references: [id])
  providerPackageId String
  packageName       String
  packageType       String // DATA-ONLY | DATA-VOICE-SMS
  retailPrice       Float
  wholesalePrice    Float
  currency          String   @default("USD")
  // pending -> paid -> fulfilling -> completed | failed | refunded
  // pending -> abandoned when the Stripe Checkout session expires unpaid
  status            String   @default("pending")
  isTopup           Boolean  @default(false)
  topupIccid        String?
  paymentProvider   String? // stripe
  paymentRef        String? // stripe payment intent / session id
  providerOrderRef  String? // esimcard order/sim ref
  failureReason     String?

  // --- Discounts & attribution (growth features) ---
  couponId       String?
  coupon         Coupon?     @relation(fields: [couponId], references: [id])
  couponCode     String? // snapshot of the code entered
  discountAmount Float       @default(0) // amount taken off retail
  influencerId   String?
  influencer     Influencer? @relation(fields: [influencerId], references: [id])
  source         String? // utm_source or referrer host or "direct"
  medium         String? // utm_medium
  campaign       String? // utm_campaign
  referrer       String? // document.referrer host

  commission AffiliateCommission?

  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@index([userId])
  @@index([status])
  @@index([couponId])
  @@index([influencerId])
  @@index([source])
}

// Key-value app settings (markup overrides, low-balance threshold, etc.)
model Setting {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt
}

// Processed Stripe webhook event ids — for idempotency (ignore replays).
model WebhookEvent {
  id        String   @id // stripe event id (evt_...)
  type      String
  createdAt DateTime @default(now())
}

// --- Support chat (one thread per customer, real-time via socket.io) ---
model SupportThread {
  id            String   @id @default(cuid())
  userId        String   @unique
  user          User     @relation(fields: [userId], references: [id])
  status        String   @default("open") // open | resolved (completed)
  starred       Boolean  @default(false) // admin favourite / important
  unreadByAdmin Int      @default(0)
  unreadByUser  Int      @default(0)
  lastMessageAt DateTime @default(now())
  createdAt     DateTime @default(now())

  messages SupportMessage[]

  @@index([lastMessageAt])
  @@index([status])
}

model SupportMessage {
  id         String        @id @default(cuid())
  threadId   String
  thread     SupportThread @relation(fields: [threadId], references: [id])
  senderId   String
  senderRole String // customer | admin
  body       String
  createdAt  DateTime      @default(now())

  @@index([threadId])
}

// --- Community tips feed ("worked great in <country>") ---
model Tip {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  country   String
  body      String
  photoUrl  String?
  status    String   @default("approved") // approved | hidden
  likes     Int      @default(0)
  createdAt DateTime @default(now())

  reports TipReport[]

  @@index([status])
  @@index([country])
}

// --- Growth: campaign bar + banners (fully admin-managed, event-driven) ---
model Promotion {
  id         String    @id @default(cuid())
  kind       String // "bar" | "banner"
  title      String
  subtitle   String?
  imageUrl   String?
  bgColor    String? // optional hex override e.g. "#0bb7a8"
  textColor  String? // optional hex override
  ctaLabel   String?
  ctaUrl     String?
  couponCode String? // optional: this promo advertises a coupon
  placement  String    @default("both") // "web" | "mobile" | "both"
  priority   Int       @default(0) // higher shows first
  active     Boolean   @default(true)
  startsAt   DateTime? // null = no start bound
  endsAt     DateTime? // null = no end bound
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  @@index([active])
}

// --- Growth: influencers / affiliates ---
// An Influencer is an affiliate. Admin-created ones have no login; self-serve
// affiliates sign up on affiliate.backpacklink.com and are linked to a User.
model Influencer {
  id              String   @id @default(cuid())
  name            String
  handle          String? // @handle
  platform        String? // instagram | youtube | tiktok | ...
  email           String?
  refCode         String   @unique // used in ?ref=CODE links and (optionally) as a coupon code
  commissionType  String? // "percent" | "fixed" | null
  commissionValue Float? // e.g. 10 => 10% or $10 per sale
  active          Boolean  @default(true)

  // --- Self-serve affiliate program ---
  userId        String?   @unique
  user          User?     @relation(fields: [userId], references: [id])
  // pending (applied) -> approved | rejected; admin-created rows are "approved"
  status        String    @default("approved")
  website       String? // main channel / site URL
  audience      String? // applicant's pitch: audience size, niche, how they'll promote
  country       String?
  payoutMethod  String? // paypal | bank | wise | other
  payoutDetails String? // e.g. PayPal email / IBAN — free text, admin-only + owner
  adminNote     String?
  approvedAt    DateTime?

  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  coupons     Coupon[]
  orders      Order[]
  clicks      AffiliateClick[]
  commissions AffiliateCommission[]
  payouts     AffiliatePayout[]

  @@index([refCode])
  @@index([status])
}

// One row per tracked ?ref= landing (deduped per visitor per day client-side).
model AffiliateClick {
  id           String     @id @default(cuid())
  influencerId String
  influencer   Influencer @relation(fields: [influencerId], references: [id], onDelete: Cascade)
  landingPath  String?
  referrer     String?
  createdAt    DateTime   @default(now())

  @@index([influencerId, createdAt])
}

// Commission earned on one completed, attributed order.
// pending (in hold period) -> approved -> paid ; void if the order is refunded.
model AffiliateCommission {
  id           String           @id @default(cuid())
  orderId      String           @unique
  order        Order            @relation(fields: [orderId], references: [id])
  influencerId String
  influencer   Influencer       @relation(fields: [influencerId], references: [id], onDelete: Cascade)
  orderAmount  Float // retail actually paid
  amount       Float // commission owed
  currency     String           @default("USD")
  status       String           @default("pending")
  payoutId     String?
  payout       AffiliatePayout? @relation(fields: [payoutId], references: [id])
  note         String?
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt

  @@index([influencerId, status])
  @@index([status])
}

// A payment the admin made to an affiliate (bundles approved commissions).
model AffiliatePayout {
  id           String                @id @default(cuid())
  influencerId String
  influencer   Influencer            @relation(fields: [influencerId], references: [id], onDelete: Cascade)
  amount       Float
  currency     String                @default("USD")
  method       String?
  reference    String? // PayPal txn id, bank ref…
  note         String?
  createdAt    DateTime              @default(now())

  commissions AffiliateCommission[]

  @@index([influencerId])
}

// --- Growth: coupon / discount codes ---
model Coupon {
  id             String    @id @default(cuid())
  code           String    @unique // matched case-insensitively in app logic
  description    String?
  discountType   String // "percent" | "fixed"
  discountValue  Float // 15 => 15% or $15
  minSubtotal    Float? // minimum order retail to apply
  maxRedemptions Int? // null = unlimited
  perUserLimit   Int?      @default(1)
  redemptions    Int       @default(0) // completed uses
  active         Boolean   @default(true)
  startsAt       DateTime?
  endsAt         DateTime?
  influencerId   String?
  influencer     Influencer? @relation(fields: [influencerId], references: [id])
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  orders Order[]

  @@index([active])
}

// --- Community moderation (App Store guideline 1.2) ---
// Travellers can report a tip and block another traveller. A tip that collects
// TIP_REPORT_HIDE_THRESHOLD reports is hidden from the feed automatically and
// waits for an admin to review it.
model TipReport {
  id         String   @id @default(cuid())
  tipId      String
  tip        Tip      @relation(fields: [tipId], references: [id])
  reporterId String
  reporter   User     @relation(fields: [reporterId], references: [id])
  reason     String?
  createdAt  DateTime @default(now())

  // One report per traveller per tip.
  @@unique([tipId, reporterId])
  @@index([tipId])
}

model UserBlock {
  id        String   @id @default(cuid())
  blockerId String
  blocker   User     @relation("BlocksMade", fields: [blockerId], references: [id])
  blockedId String
  blocked   User     @relation("BlocksReceived", fields: [blockedId], references: [id])
  createdAt DateTime @default(now())

  @@unique([blockerId, blockedId])
  @@index([blockerId])
}

// --- Admin-managed content (FAQ, blog, testimonials) ---
model Faq {
  id        String   @id @default(cuid())
  question  String
  answer    String
  sortOrder Int      @default(0) // lower shows first
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([active])
}

model Article {
  id            String   @id @default(cuid())
  slug          String   @unique
  title         String
  excerpt       String
  emoji         String   @default("📝") // cover art when no image
  coverImageUrl String?
  body          String // markdown-ish: blank line = new paragraph, "## " = heading
  readMins      Int      @default(3)
  published     Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([published])
}

model Testimonial {
  id        String   @id @default(cuid())
  name      String
  location  String?
  quote     String
  rating    Int      @default(5)
  imageUrl  String? // optional review screenshot
  sortOrder Int      @default(0)
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([active])
}
