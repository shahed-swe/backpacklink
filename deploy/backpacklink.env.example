# Production env for the server. Copy to ~/backpacklink.env and fill in.
# The deploy workflow copies this into the repo checkout as .env before
# `docker compose up`. Compose uses it for BOTH build-arg interpolation
# (NEXT_PUBLIC_*) and the api container's env_file.
#
# Replace 135.119.89.30 with your domain once you have one (+ HTTPS).

# --- esimcard ---
ESIMCARD_BASE_URL=https://portal.esimcard.com/api/developer/reseller
ESIMCARD_TOKEN=PUT_YOUR_ROTATED_TOKEN_HERE

# --- app URLs (browser-facing → must be the server's public address) ---
NEXT_PUBLIC_API_URL=http://135.119.89.30:4000
NEXT_PUBLIC_SITE_URL=http://135.119.89.30:3000
WEB_URL=http://135.119.89.30:3000
# Include https://affiliate.backpacklink.com here if CORS is restricted.
NEXT_PUBLIC_AFFILIATE_URL=https://affiliate.backpacklink.com
CORS_ORIGINS=http://135.119.89.30:3000,http://135.119.89.30:3001

# --- auth ---
JWT_SECRET=CHANGE_ME_TO_A_LONG_RANDOM_STRING
JWT_EXPIRES_IN=30d

# --- pricing ---
MARKUP_PERCENT=50
MARKUP_MIN_PROFIT=0
DISPLAY_CURRENCY=USD

# --- Stripe (use live keys for real payments; test keys for staging) ---
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PUBLISHABLE_KEY=

# --- fulfillment: mock | live ---
FULFILLMENT_MODE=live
LOW_BALANCE_THRESHOLD=10

# --- admin seed (first boot) ---
ADMIN_EMAIL=admin@backpacklink.local
ADMIN_PASSWORD=CHANGE_ME
