{
  "name": "backpacklink",
  "version": "0.1.0",
  "private": true,
  "description": "BackpackLink — international eSIM reseller platform (backend + web + mobile)",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev:api": "npm run dev -w @backpacklink/api",
    "start:api": "npm run start -w @backpacklink/api",
    "dev:web": "npm run dev -w @backpacklink/web",
    "build:web": "npm run build -w @backpacklink/web",
    "dev:admin": "npm run dev -w @backpacklink/admin",
    "build:admin": "npm run build -w @backpacklink/admin",
    "probe": "node scripts/probe.mjs"
  },
  "engines": {
    "node": ">=18"
  }
}
